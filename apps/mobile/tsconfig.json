{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@mugabe/fitness-content": ["../../packages/fitness-content/src/index.ts"],
      "@mugabe/fitness-content/*": ["../../packages/fitness-content/src/*"]
    },
    // TypeScript 6 no longer loads every @types package by default.
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
